NODE_ENV=development
PORT=8080

# Gere uma chave longa e aleatória. Não use este valor em produção.
WORKER_API_KEY=troque-por-uma-chave-com-pelo-menos-32-caracteres

# Copie o endpoint e o token exibidos no painel do Browserless.
BROWSERLESS_WS_URL=wss://production-sfo.browserless.io
BROWSERLESS_TOKEN=seu-token-browserless

# Endereço real da tela de entrada do Koper.
KOPER_LOGIN_URL=https://seu-endereco-koper.example.com
