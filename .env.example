NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA

# Nunca use a service_role no navegador.
# Quando ela for necessária no futuro, deverá existir somente no servidor/Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Elos IA (somente servidor). Ver docs/elos-ia/README.md.
OPENAI_API_KEY=
# Opcionais — os valores abaixo são os padrões.
# ELOS_IA_MODEL=gpt-6-luna
# ELOS_IA_REASONING_EFFORT=low
# ELOS_IA_MAX_OUTPUT_TOKENS=16000
# ELOS_IA_MAX_ROUNDS=4
# ELOS_IA_TURN_TOKEN_BUDGET=60000
# ELOS_IA_DAILY_TOKENS_PER_USER=300000
# ELOS_IA_MONTHLY_TOKENS_PER_COMPANY=5000000
