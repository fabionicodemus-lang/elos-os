/** Structured evidence generated by the server from authorized tool results. */
export type ElosIaVisualMetric = {
  label: string;
  value: number | null;
  format: "money" | "percent" | "days" | "number";
  tone?: "neutral" | "positive" | "warning" | "danger";
};

export type ElosIaVisualBase = {
  id: string;
  title: string;
  projectLabel: string;
  /** YYYY-MM-DD, in the business timezone; never a model-generated date. */
  asOfDate: string;
  sourceLabel: string;
  warnings: string[];
  metrics: ElosIaVisualMetric[];
  /** Definitions/assumptions that should remain visible beside the chart. */
  notes?: string[];
  /** Actual request timestamp, when supplied by the server. */
  generatedAt?: string;
  periodLabel?: string;
};

export type ElosIaCostVisual = ElosIaVisualBase & {
  type: "cost-composition";
  budget: number;
  projected: number;
  remaining: number;
  segments: Array<{
    key: "paid" | "payable" | "unbilled" | "toCommit";
    label: string;
    value: number;
  }>;
};

export type ElosIaScheduleVisual = ElosIaVisualBase & {
  type: "schedule";
  plannedFinish: string | null;
  projectedFinish: string | null;
  delayDays: number | null;
  points: Array<{
    key: string;
    label: string;
    planned: number | null;
    actual: number | null;
    projected: number | null;
  }>;
};

export type ElosIaCashflowVisual = ElosIaVisualBase & {
  type: "cashflow";
  engineeringIncluded: boolean;
  points: Array<{
    key: string;
    label: string;
    received: number;
    receivable: number;
    paid: number;
    payable: number;
    engineering: number;
    cumulative: number;
  }>;
};

export type ElosIaResultVisual = ElosIaVisualBase & {
  type: "result-waterfall";
  steps: Array<{ label: string; kind: "total" | "delta"; value: number }>;
};

export type ElosIaProposalVisual = ElosIaVisualBase & {
  type: "proposal-comparison";
  discountAnnualPct: number | null;
  valuationDate: string | null;
  assumptions: string[];
  scenarios: Array<{
    label: string;
    nominal: number;
    presentValue: number | null;
    marginPct: number | null;
  }>;
};

export type ElosIaVisual =
  | ElosIaCostVisual
  | ElosIaScheduleVisual
  | ElosIaCashflowVisual
  | ElosIaResultVisual
  | ElosIaProposalVisual;

/** Only the server creates observations, after the normal permission checks. */
export type ElosIaToolObservation = {
  /** Invocation order, assigned before awaiting parallel tools. */
  sequence: number;
  name: string;
  args: Record<string, unknown>;
  result: unknown;
};

export const ELOS_IA_MAX_VISUALS: number;
export const ELOS_IA_MAX_VISUAL_POINTS: number;
export function buildElosIaVisuals(input: {
  observations: ElosIaToolObservation[];
  today: string;
  generatedAt?: string;
}): ElosIaVisual[];
/** Validate HTTP/cache data, discard unknown fields and bound payload sizes. */
export function sanitizeElosIaVisuals(value: unknown): ElosIaVisual[];
